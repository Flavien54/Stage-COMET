"""
==================================================
Affichage carte surface TIFF en 3D - Version générique
(s'adapte automatiquement aux fichiers "aligned" et
 "roughness" en fonction du nom de fichier)
==================================================
"""

import re
import os

import numpy as np
import matplotlib.pyplot as plt
from matplotlib import cm
from mpl_toolkits.mplot3d import Axes3D  # noqa: F401 (nécessaire pour projection='3d')
from scipy.ndimage import zoom
from tkinter import Tk, filedialog
import tifffile

# ==================================================
# Sélection fichier TIFF
# ==================================================

root = Tk()
root.withdraw()
filename = filedialog.askopenfilename(
    title="Sélectionner la carte surface TIFF",
    filetypes=[("TIFF files", "*.tif *.tiff")]
)
root.destroy()

if not filename:
    print("Aucun fichier sélectionné")
    raise SystemExit

print(f"Fichier chargé :\n{filename}")

base_name = os.path.splitext(os.path.basename(filename))[0]

# ==================================================
# Détection du type de donnée (aligned / roughness)
# à partir du nom de fichier
# ==================================================
# -> Ajoute simplement tes propres mots-clés dans les
#    regex ci-dessous si tes fichiers utilisent une
#    autre convention de nommage.

if re.search(r"rough|rugo", base_name, re.IGNORECASE):
    data_type = "roughness"
elif re.search(r"align", base_name, re.IGNORECASE):
    data_type = "aligned"
else:
    print(f'Type de donnée non détecté dans "{base_name}" -> "aligned" par défaut.')
    data_type = "aligned"

if data_type == "aligned":
    type_label_fr = "Hauteur alignée"
    type_label_titre = "aligned"
    unit_label = "mm"
    unit_factor = 1e3  # conversion m -> mm
else:  # roughness
    type_label_fr = "Rugosité"
    type_label_titre = "roughness"
    unit_label = "µm"
    unit_factor = 1e6  # conversion m -> µm (ajuste si déjà en µm : mettre 1.0)

# Nom d'échantillon "propre" : on retire le mot-clé de type du nom de fichier
sample_label = re.sub(r"[-_ ]?(aligned|rough|rugo).*", "", base_name, flags=re.IGNORECASE)
if not sample_label:
    sample_label = base_name

# ==================================================
# Lecture TIFF
# ==================================================

img = tifffile.imread(filename)
if img.ndim > 2:
    img = img[0]  # slice 1 si stack

img = img.astype(np.float64)

# Conversion selon le type de donnée détecté
img = img * unit_factor

# Gestion NaN
if np.isnan(img).any():
    mean_val = np.nanmean(img)
    img = np.nan_to_num(img, nan=mean_val)

# Sur-échantillonnage (bicubique, order=3)
scale = 4
img = zoom(img, scale, order=3)

# ==================================================
# Dimensions physiques
# ==================================================

width_mm = 34.96
height_mm = 23.57

n_rows, n_cols = img.shape
y = np.linspace(0, width_mm, n_cols)
z = np.linspace(0, height_mm, n_rows)
Y, Z = np.meshgrid(y, z)

# ==================================================
# Echelle couleur
# ==================================================

vmin = np.nanmin(img)
vmax = np.nanmax(img)

# ==================================================
# Figure 3D - fond blanc classique
# ==================================================

fig_title = f"{sample_label} - Surface {type_label_titre} map"
z_label_str = f"{type_label_fr} ({unit_label})"

fig = plt.figure(figsize=(10, 7), facecolor="w")
fig.canvas.manager.set_window_title(fig_title)
ax = fig.add_subplot(111, projection="3d")
ax.set_facecolor("w")

# Sous-échantillonnage POUR L'AFFICHAGE UNIQUEMENT (données img intactes).
# plot_surface devient très lourd / peut planter au-delà de quelques
# centaines de milliers de points -> on vise ~300x300 points affichés max.
max_points_per_axis = 300
step_r = max(1, n_rows // max_points_per_axis)
step_c = max(1, n_cols // max_points_per_axis)

surf = ax.plot_surface(
    Y[::step_r, ::step_c],
    Z[::step_r, ::step_c],
    img[::step_r, ::step_c],
    cmap=cm.jet,
    vmin=vmin, vmax=vmax,
    linewidth=0,
    antialiased=False,
    rstride=1, cstride=1
)

cbar = fig.colorbar(surf, ax=ax, shrink=0.6, pad=0.1)
cbar.set_label(z_label_str, color="k")
cbar.ax.yaxis.set_tick_params(color="k")
plt.setp(plt.getp(cbar.ax.axes, "yticklabels"), color="k")

ax.set_xlabel("Y (mm)", color="k")
ax.set_ylabel("Z (mm)", color="k")
ax.set_zlabel(z_label_str, color="k")
ax.set_title(fig_title, color="k", fontweight="bold")

ax.view_init(elev=30, azim=45)

plt.tight_layout()
plt.show()
