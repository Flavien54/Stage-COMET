import matplotlib
matplotlib.use("TkAgg")

import tkinter as tk
from tkinter import filedialog

import numpy as np
import tifffile

import matplotlib.pyplot as plt
from matplotlib.gridspec import GridSpec

from scipy.ndimage import zoom


# ==================================================
# Sélection fichier TIFF
# ==================================================

root = tk.Tk()
root.withdraw()

filename = filedialog.askopenfilename(
    title="Sélectionner la carte surface TIFF",
    filetypes=[("TIFF files", "*.tif *.tiff")]
)

if filename == "":
    print("Aucun fichier sélectionné")
    exit()

print("Fichier chargé :")
print(filename)


# ==================================================
# Lecture TIFF
# ==================================================

img = tifffile.imread(filename)

print("\nInformations TIFF")
print("----------------")
print("Dimensions :", img.shape)
print("Type :", img.dtype)
print("Min brut :", np.nanmin(img))
print("Max brut :", np.nanmax(img))

if img.ndim == 3:
    print("Stack 3D détecté -> slice 0")
    img = img[0]

img = img.astype(float)

# Conversion m -> mm
img = img * 1e3

print("\nAprès conversion mm")
print("-------------------")
print("Min :", np.nanmin(img), "mm")
print("Max :", np.nanmax(img), "mm")

# Gestion NaN
if np.isnan(img).any():
    print("NaN détectés")
    img[np.isnan(img)] = np.nanmean(img)

# Sur-échantillonnage
scale = 4
img = zoom(img, zoom=scale, order=3)
print("Nouvelle résolution :", img.shape)


# ==================================================
# Dimensions physiques
# ==================================================

width_mm = 34.96
height_mm = 23.57


# ==================================================
# Echelle couleur
# ==================================================

vmin = -0.08
vmax = 0.04

if np.nanmin(img) > vmin or np.nanmax(img) < vmax:
    vmin = np.nanmin(img)
    vmax = np.nanmax(img)


# ==================================================
# Figure
# ==================================================

plt.style.use("dark_background")

# Fenêtre plus grande
fig = plt.figure(figsize=(20, 9), dpi=110)
fig.patch.set_facecolor("black")

# Layout :
#   - Colonne gauche : infos
#   - Colonne droite : carte + colorbar horizontale en bas
gs = GridSpec(
    2, 2,
    figure=fig,
    width_ratios=[0.13, 1.0],
    height_ratios=[1.0, 0.06],
    wspace=0.02,
    hspace=0.25,
    left=0.02, right=0.98,
    top=0.94, bottom=0.10
)


# --------------------------------------------------
# Panneau d'information (gauche, sur les 2 lignes)
# --------------------------------------------------
ax_info = fig.add_subplot(gs[:, 0])
ax_info.axis("off")

info = (
    f"{width_mm:.2f} × {height_mm:.2f} mm\n\n"
    f"Range  Min: {np.nanmin(img):.2f}  Max: {np.nanmax(img):.2f} mm\n\n"
    f"Slice 1 / 1\n\n\n"
    f"Yaw:   90.0 °\n\n"
    f"Pitch: 90.0 °\n\n"
    f"Roll:  91.2 °"
)

ax_info.text(
    0.0, 1.0, info,
    fontsize=13,
    color="#4fc3f7",
    verticalalignment="top",
    horizontalalignment="left",
    family="sans-serif",
    transform=ax_info.transAxes
)


# --------------------------------------------------
# Carte principale (haut droite) — large
# --------------------------------------------------
ax = fig.add_subplot(gs[0, 1])

im = ax.imshow(
    img,
    cmap="jet",
    origin="lower",
    extent=[0, width_mm, 0, height_mm],
    interpolation="bicubic",
    vmin=vmin,
    vmax=vmax,
    aspect="auto"          # étire pour remplir toute la largeur
)

ax.set_xlim(0, width_mm)
ax.set_ylim(0, height_mm)

ax.set_xlabel("Y (mm)", fontsize=12)
ax.set_ylabel("Z (mm)", fontsize=12)
ax.set_title("EchantillonCM-11 - Surface aligned map", fontsize=15, pad=8)

# Couleurs des ticks
ax.tick_params(colors="white", labelsize=11)


# --------------------------------------------------
# Colorbar horizontale (bas droite)
# --------------------------------------------------
ax_cbar = fig.add_subplot(gs[1, 1])

cbar = fig.colorbar(
    im,
    cax=ax_cbar,
    orientation="horizontal"
)

cbar.set_label("Aligned (mm)", fontsize=12, color="white")
cbar.ax.tick_params(colors="white", labelsize=11)
cbar.outline.set_edgecolor("white")


# --------------------------------------------------
# Petite annotation "Object Count" en bas à gauche
# --------------------------------------------------
fig.text(
    0.02, 0.02,
    "Object Count: 194",
    fontsize=12,
    color="#4fc3f7",
    ha="left", va="bottom"
)


# ==================================================
# Toolbar : coordonnées en mm
# ==================================================

def format_coord(x, y):
    try:
        col = int((x / width_mm) * img.shape[1])
        row = int((y / height_mm) * img.shape[0])
        if 0 <= row < img.shape[0] and 0 <= col < img.shape[1]:
            value = img[row, col]
            return (
                f"X={x:.3f} mm   "
                f"Y={y:.3f} mm   "
                f"Z={value:.5f} mm"
            )
    except Exception:
        pass
    return f"X={x:.3f} mm   Y={y:.3f} mm"


ax.format_coord = format_coord


# ==================================================
# Affichage
# ==================================================

plt.show()
