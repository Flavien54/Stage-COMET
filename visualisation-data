"""
==================================================
Affichage carte surface TIFF en 3D - Version simple
==================================================
"""

import numpy as np
import matplotlib.pyplot as plt
from matplotlib import cm
from mpl_toolkits.mplot3d import Axes3D  # noqa: F401 (nécessaire pour projection='3d')
from scipy.ndimage import zoom
from tkinter import Tk, filedialog
import tifffile

# ==================================================
# Sélection fichier TIFF
# ==================================================

root = Tk()
root.withdraw()
filename = filedialog.askopenfilename(
    title="Sélectionner la carte surface TIFF",
    filetypes=[("TIFF files", "*.tif *.tiff")]
)
root.destroy()

if not filename:
    print("Aucun fichier sélectionné")
    raise SystemExit

print(f"Fichier chargé :\n{filename}")

# ==================================================
# Lecture TIFF
# ==================================================

img = tifffile.imread(filename)
if img.ndim > 2:
    img = img[0]  # slice 1 si stack

img = img.astype(np.float64)

# Conversion m -> mm
img = img * 1e3

# Gestion NaN
if np.isnan(img).any():
    mean_val = np.nanmean(img)
    img = np.nan_to_num(img, nan=mean_val)

# Sur-échantillonnage (bicubique, order=3)
scale = 4
img = zoom(img, scale, order=3)

# ==================================================
# Dimensions physiques
# ==================================================

width_mm = 34.96
height_mm = 23.57

n_rows, n_cols = img.shape
y = np.linspace(0, width_mm, n_cols)
z = np.linspace(0, height_mm, n_rows)
Y, Z = np.meshgrid(y, z)

# ==================================================
# Echelle couleur
# ==================================================

vmin = np.nanmin(img)
vmax = np.nanmax(img)

# ==================================================
# Figure 3D - fond blanc classique
# ==================================================

fig = plt.figure(figsize=(10, 7), facecolor="w")
ax = fig.add_subplot(111, projection="3d")
ax.set_facecolor("w")

# Sous-échantillonnage POUR L'AFFICHAGE UNIQUEMENT (les données restent intactes).
# plot_surface devient très lourd / peut planter au-delà de quelques centaines
# de milliers de points -> on vise ~300x300 points affichés max.
max_points_per_axis = 300
step_r = max(1, n_rows // max_points_per_axis)
step_c = max(1, n_cols // max_points_per_axis)

surf = ax.plot_surface(
    Y[::step_r, ::step_c],
    Z[::step_r, ::step_c],
    img[::step_r, ::step_c],
    cmap=cm.jet,
    vmin=vmin, vmax=vmax,
    linewidth=0,
    antialiased=False,
    rstride=1, cstride=1
)

cbar = fig.colorbar(surf, ax=ax, shrink=0.6, pad=0.1)
cbar.set_label("Aligned (mm)")

ax.set_xlabel("Y (mm)")
ax.set_ylabel("Z (mm)")
ax.set_zlabel("Aligned (mm)")
ax.set_title("EchantillonCM-11 - Surface aligned map")

ax.view_init(elev=30, azim=45)

plt.tight_layout()
plt.show()
